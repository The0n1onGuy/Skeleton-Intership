<Page
    x:Class="PROYECTWEVENTS.Z_Proyect_Pages.PROFILEVIEW"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PROYECTWEVENTS.Z_Proyect_Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:PROYECTWEVENTS.CustClasses"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#e6e6e6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#e6e6e6" x:Name="SafeAreaGrid" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top">

            <Border Padding="10"
                Width="350"
                Height="1000"
                Background="#e6e6e6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Volver" Style="{StaticResource CustomBackButtonStyle}" Click="CustomBacc_Click" Foreground="#0d99ff"/>

                    <StackPanel Grid.Row="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,12,0,0" Spacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="TESTING CAHNGES(s)"
                               FontSize="14"
                               Margin="0,0,0,0"     
                               FontWeight="Normal"
                               TextAlignment="Center"
                               HorizontalAlignment="Left"
                               Style="{StaticResource LabelContext}"/>

                            <TextBox
                        Width="300"
                        Margin="0,0,0,15"                        
                        Style="{StaticResource EditorTextBox}"
                        AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material"
                        x:Name="NombreTxt"
                        MaxLength="49"
                        />

                            <TextBlock Text="Apellidos"
                        FontSize="14"
                        Margin="0,0,0,0"     
                        FontWeight="Normal"
                        TextAlignment="Center"
                        HorizontalAlignment="Left"/>
                            <TextBox
                        Width="300"
                        Margin="0,0,0,15"                        
                        Style="{StaticResource EditorTextBox}"
                        MaxLength="49"
                        x:Name="ApellidosTxt"
                        AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <TextBlock Text="Correo Electronico"
                        FontSize="14"
                        Margin="0,0,0,0"     
                        FontWeight="Normal"
                        TextAlignment="Center"
                        HorizontalAlignment="Left"/>
                            <TextBox
                        Width="300"
                        Margin="0,0,0,15"
                        x:Name="CorreoTxt"
                        MaxLength="49"
                        Style="{StaticResource EditorTextBox}"
                        AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <TextBlock Text="Numero Telefonico"
                        FontSize="14"
                        Margin="0,0,0,0"     
                        FontWeight="Normal"
                        TextAlignment="Center"
                        HorizontalAlignment="Left"/>
                            <TextBox
                        Width="300"
                        Margin="0,0,0,15"
                        x:Name="TelefonoTxt"
                        MaxLength="14"
                        Style="{StaticResource EditorTextBox}"
                        AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <TextBlock Text="Contraseña"
                        FontSize="14"
                        Margin="0,0,0,0"     
                        FontWeight="Normal"
                        TextAlignment="Center"
                        HorizontalAlignment="Left"/>
                            <PasswordBox 
                        Width="300"
                        Margin="0,0,0,15"                        
                        Style="{StaticResource EditorTextBox}"
                        x:Name="ContrasenaTxt"                                
                        MaxLength="12"
                        AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <ItemsControl x:Name="ListaArch" Height="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ArchivoItem">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind Filename}" />
                                            <Button Content="Ver archivo"
                                                    Click="ViewFile_Click"
                                                    Tag="{x:Bind FileUrl}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
