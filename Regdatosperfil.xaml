<Page
    x:Class="PROYECTWEVENTS.Z_Proyect_Pages.Regdatosperfil"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PROYECTWEVENTS.Z_Proyect_Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#e6e6e6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#e6e6e6" x:Name="SafeAreaGrid" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top">

            <Border Padding="10"
Width="350"
Background="#e6e6e6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Button Content="Volver" Style="{StaticResource CustomBackButtonStyle}" Click="CustomBacc_Click" Foreground="#0d99ff"/>

                    <StackPanel Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0" Spacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Nombre"
                           FontSize="14"
                           Margin="0,0,0,0"     
                           FontWeight="Normal"
                           TextAlignment="Center"
                           HorizontalAlignment="Left"
                           Style="{StaticResource LabelContext}"/>

                            <TextBox
                    Width="300"
                    Margin="0,0,0,15"                        
                    Style="{StaticResource EditorTextBox}"
                    AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material"
                    x:Name="NombreTxt"
                    MaxLength="49"
                    />

                            <TextBlock Text="Apellidos"
                    FontSize="14"
                    Margin="0,0,0,0"     
                    FontWeight="Normal"
                    TextAlignment="Center"
                    HorizontalAlignment="Left"/>
                            <TextBox
                    Width="300"
                    Margin="0,0,0,15"                        
                    Style="{StaticResource EditorTextBox}"
                    MaxLength="49"
                    x:Name="ApellidosTxt"
                    AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <TextBlock Text="Pais"
                                FontSize="14"
                                Margin="0,0,0,0"     
                                FontWeight="Normal"
                                TextAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <ComboBox x:Name="ComboPais" 
                                PlaceholderText="Seleccione su Pais"
                                SelectionChanged="ComboPais_SelectionChanged"/>
                            <TextBlock Text="Provincia/Estado"
                                FontSize="14"
                                Margin="0,0,0,0"     
                                FontWeight="Normal"
                                TextAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <ComboBox x:Name="ComboEstado"
                                PlaceholderText="Seleccione su Estado"
                                SelectionChanged="ComboEstado_SelectionChanged"/>
                            <TextBlock Text="Delegación/Municipio"
                                FontSize="14"
                                Margin="0,0,0,0"     
                                FontWeight="Normal"
                                TextAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <ComboBox x:Name="ComboMunicipio"
                                SelectionChanged="ComboMunicipio_SelectionChanged"
                                PlaceholderText="Seleccione su Municipio"/>
                            
                            <TextBlock Text="Codigo Postal"
                                FontSize="14"
                                Margin="0,0,0,0"     
                                FontWeight="Normal"
                                TextAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <TextBox
                                Width="300"
                                Margin="0,0,0,15"                        
                                Style="{StaticResource EditorTextBox}"
                                MaxLength="49"
                                InputScope="Number"
                                x:Name="CodigoPTxt"
                                AutomationProperties.AutomationId="TextBox_Default_Placeholder_Material" />
                            <TextBlock Text="Mapa"
                                FontSize="14"
                                Margin="0,0,0,0"     
                                FontWeight="Normal"
                                TextAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <Border BorderThickness="1" BorderBrush="Gray" Width="300" Height="400">
                                <WebView x:Name="MapaWebView"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                            </Border>
                            
                            <Button Margin="0,30,0,0"  Width="300" Content="Siguiente" Click="NextPage_Click" CornerRadius="5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
